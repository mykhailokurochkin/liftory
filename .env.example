# Copy using pnpm run setup:env; generated local passwords remain outside Git.
NODE_ENV=development
APP_ORIGIN=http://localhost:3300
API_HOST=127.0.0.1
API_PORT=3301
API_INTERNAL_URL=http://127.0.0.1:3301
APP_VERSION=local
LIFTORY_DEV_AUTH=true
DATABASE_URL=postgresql://liftory_local:replace-local-password@127.0.0.1:55432/liftory_local
POSTGRES_DB=liftory_local
POSTGRES_USER=liftory_local
POSTGRES_PASSWORD=replace-local-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Set public to allow any verified Google account.
REGISTRATION_MODE=allowlist
ALLOWED_EMAILS=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-only DNS fallback for a verified HTTPS Tailscale API; normally empty.
API_DNS_FALLBACK_IPS=
